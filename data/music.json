    {
      "id": "rebound",
      "title": "Rebound",
      "artist": "Josh Woodward",
      "mood": "清爽电子流行",
      "description": "轻快一点，适合随意逛逛。",
      "src": "./media/rebound.mp3",
      "sourceUrl": "https://www.joshwoodward.com/song/Rebound",
      "instrumental": false,
      "lyrics": [
        {
          "time": 4.56,
          "end": 7.06,
          "text": "We're snuggled in your sheets"
        },
        {
          "time": 6.5,
          "end": 10.26,
          "text": "Like a comfortable cocoon"
        },
        {
          "time": 9.66,
          "end": 14.5,
          "text": "I'm cozy in the heat"
        },
        {
          "time": 14.14,
          "end": 17.7,
          "text": "But there's a ghost that's in your room"
        },
        {
          "time": 17.1,
          "end": 20.26,
          "text": "Your body is beside me"
        },
        {
          "time": 19.84,
          "end": 25.18,
          "text": "But your mind is in another world"
        },
        {
          "time": 24.58,
          "end": 27.64,
          "text": "Are you trying to even hide it?"
        },
        {
          "time": 28.56,
          "end": 31.74,
          "text": "He's still here"
        },
        {
          "time": 33.2,
          "end": 37.44,
          "text": "All aboard, you're heading toward"
        },
        {
          "time": 36.84,
          "end": 40.2,
          "text": "The next stop down the line"
        },
        {
          "time": 39.6,
          "end": 43.0,
          "text": "Will you stay beside me?"
        },
        {
          "time": 44.1,
          "end": 47.86,
          "text": "Am I just along for the ride?"
        },
        {
          "time": 48.04,
          "end": 52.56,
          "text": "I'm a …, I'm a …, I'm a …, I'm a rebound"
        },
        {
          "time": 56.22,
          "end": 59.54,
          "text": "You told me 'bout your past"
        },
        {
          "time": 59.14,
          "end": 62.8,
          "text": "How you used to play the drums"
        },
        {
          "time": 63.72,
          "end": 67.04,
          "text": "Your allergy to cats"
        },
        {
          "time": 66.64,
          "end": 70.06,
          "text": "About your double-jointed thumbs"
        },
        {
          "time": 69.46,
          "end": 72.78,
          "text": "But there is something that you left out"
        },
        {
          "time": 72.18,
          "end": 77.46,
          "text": "I can read you like an open book"
        },
        {
          "time": 76.86,
          "end": 80.34,
          "text": "I wanna close it but I'm stressed out"
        },
        {
          "time": 81.12,
          "end": 84.3,
          "text": "He's still here"
        },
        {
          "time": 85.76,
          "end": 89.92,
          "text": "All aboard, you're heading toward"
        },
        {
          "time": 89.32,
          "end": 92.7,
          "text": "The next stop down the line"
        },
        {
          "time": 92.1,
          "end": 95.52,
          "text": "Will you stay beside me?"
        },
        {
          "time": 96.56,
          "end": 100.36,
          "text": "Am I just along for the ride?"
        },
        {
          "time": 99.76,
          "end": 105.02,
          "text": "I'm a …, I'm a …, I'm a …, I'm a rebound"
        },
        {
          "time": 107.84,
          "end": 112.26,
          "text": "No, I don't wanna be your stepping stone"
        },
        {
          "time": 111.66,
          "end": 116.02,
          "text": "Or attached like a cast to your broken bone"
        },
        {
          "time": 115.42,
          "end": 121.92,
          "text": "I don't want to be like the duct tape that's holding your bumper on"
        },
        {
          "time": 122.82,
          "end": 127.38,
          "text": "You catch and release, and I took the bait"
        },
        {
          "time": 126.78,
          "end": 132.12,
          "text": "And I just don't know how much longer I can wait"
        },
        {
          "time": 133.34,
          "end": 137.18,
          "text": "Would you just stay?"
        },
        {
          "time": 138.68,
          "end": 142.58,
          "text": "All aboard, you're heading toward"
        },
        {
          "time": 141.98,
          "end": 145.4,
          "text": "The next stop down the line"
        },
        {
          "time": 144.8,
